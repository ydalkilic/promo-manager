# --- Database ---
# `options=-c statement_timeout=5000` caps any single query at 5s. Without it a
# pathological query holds a pool connection indefinitely, which is what turns
# a slow query into an outage: the pool drains and healthy requests queue behind
# it. The ingestion worker overrides this with a longer value (see
# docker-compose.yml) because its batch writes are legitimately slower.
DATABASE_URL="postgresql://modaco:modaco@localhost:5432/modaco?schema=public&connection_limit=20&pool_timeout=10&options=-c%20statement_timeout%3D5000"

# --- Cache / Queue ---
REDIS_URL="redis://localhost:6379"

# --- HTTP ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Caching behaviour (Scenario B) ---
CACHE_ENABLED=true
CACHE_TTL_PRODUCT_SECONDS=300
CACHE_TTL_LIST_SECONDS=30
# In-process L1 cache. CACHE_L1_TTL_MS is the worst-case staleness window
# after a promotion changes, because L1 hits never consult Redis.
CACHE_L1_ENABLED=true
CACHE_L1_TTL_MS=1000
CACHE_L1_MAX_ENTRIES=10000

# --- Ingestion tuning (Scenario A) ---
# Rows handled by a single serverless invocation. Sized so one chunk
# completes far inside the platform timeout with headroom for retries.
INGESTION_CHUNK_ROWS=2000
# Wall-clock budget for one invocation. The splitter and the chunk
# processor both yield voluntarily before this elapses.
INGESTION_INVOCATION_BUDGET_MS=90000
# Hard ceiling of the serverless plan, for reference in logs/docs.
INGESTION_PLATFORM_TIMEOUT_MS=300000
# Concurrent chunk workers. Bounded to protect the Postgres pool.
INGESTION_WORKER_CONCURRENCY=4
INGESTION_MAX_ATTEMPTS=3
# Local blob-storage root (stands in for S3 / Azure Blob).
BLOB_STORAGE_ROOT="./storage"

# --- Availability guards ---
# Sorting by effective price cannot use an index, so a deep OFFSET sorts every
# row before it. Capping the computed offset (page-1)*limit closes an
# unauthenticated request that measured ~380ms of database work each time.
MAX_PAGINATION_OFFSET=10000
# How far ?at= may project. Unbounded dates are pure cache-key cardinality.
AT_MAX_SKEW_DAYS=400

# Rate limits, per client per minute, by route class. Set RATE_LIMIT_ENABLED to
# false only for load testing. The limiter FAILS OPEN if Redis is unreachable:
# a cache outage must not become a storefront outage.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ_PER_MIN=300
RATE_LIMIT_SIMULATION_PER_MIN=20
RATE_LIMIT_WRITE_PER_MIN=60
RATE_LIMIT_INGESTION_PER_MIN=5

# Express `trust proxy`. This decides what req.ip resolves to, and therefore
# what the rate limiter keys on. Unset behind a load balancer, every caller
# looks like the balancer and the limiter protects nothing; set to "true",
# X-Forwarded-For is caller-supplied and the limiter is bypassable. Use the
# number of proxies actually in front of this service, e.g. "1".
TRUST_PROXY=loopback

# Concurrent ingestion jobs allowed system-wide. One trigger fans out to ~250
# chunk jobs, each holding a database connection while it writes.
MAX_ACTIVE_INGESTION_JOBS=3
