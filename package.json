{
  "name": "modaco-promotion-api",
  "version": "1.0.0",
  "private": true,
  "description": "ModaCo Promotion Management API - product catalog, promotions, and high-volume vendor ingestion",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "worker": "tsx src/adapters/local-runner/worker.ts",
    "worker:prod": "node dist/adapters/local-runner/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:push": "prisma db push --skip-generate",
    "seed": "tsx src/scripts/seed.ts",
    "generate:vendor-file": "tsx src/scripts/generate-vendor-file.ts",
    "ingest": "tsx src/scripts/ingest.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/functions": "^4.16.5",
    "@prisma/client": "^6.1.0",
    "bullmq": "^5.34.0",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prisma": "^6.1.0",
    "rate-limiter-flexible": "^11.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "newman": "^6.2.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
