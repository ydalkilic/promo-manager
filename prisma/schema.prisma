// ModaCo Promotion Management API — data model.
//
// The authoritative DDL is in prisma/migrations/ (current state mirrored at
// ./schema.sql). Guarantees Prisma cannot express live there in SQL: the GiST
// EXCLUDE constraints behind "at most one active promotion", partial indexes on
// status = 'ACTIVE', and the CHECK constraints.
//
// Prisma owns migrations, the typed client, and all writes; the two hot read
// paths use hand-written SQL. See ADR-002.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("discount_type")
}

enum PromotionScope {
  PRODUCT
  CATEGORY

  @@map("promotion_scope")
}

enum PromotionStatus {
  ACTIVE
  CANCELLED

  @@map("promotion_status")
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  sku           String   @unique
  name          String
  category      String
  basePrice     Decimal  @map("base_price") @db.Decimal(12, 2)
  stockQuantity Int      @map("stock_quantity")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  promotions Promotion[]

  @@index([category])
  @@index([category, basePrice])
  @@map("products")
}

model Promotion {
  id           String          @id @default(uuid()) @db.Uuid
  name         String
  discountType DiscountType    @map("discount_type")
  value        Decimal         @db.Decimal(12, 2)
  scope        PromotionScope
  // Exactly one of productId / category is set; a CHECK constraint enforces it.
  productId    String?         @map("product_id") @db.Uuid
  category     String?
  startsAt     DateTime        @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime        @map("ends_at") @db.Timestamptz(6)
  status       PromotionStatus @default(ACTIVE)
  cancelledAt  DateTime?       @map("cancelled_at") @db.Timestamptz(6)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("promotions")
}

// ---------------------------------------------------------------------------
// Ingestion bookkeeping (Scenario A). These tables hold the progress a
// stateless runtime will not, which is what makes every invocation resumable.
// ---------------------------------------------------------------------------

enum IngestionJobStatus {
  SPLITTING
  PROCESSING
  COMPLETED
  FAILED

  @@map("ingestion_job_status")
}

enum IngestionChunkStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED

  @@map("ingestion_chunk_status")
}

model IngestionJob {
  id             String             @id @default(uuid()) @db.Uuid
  fileKey        String             @map("file_key")
  status         IngestionJobStatus @default(SPLITTING)
  totalBytes     BigInt             @map("total_bytes")
  // How far the splitter has scanned; it resumes from exactly here.
  splitCursor    BigInt             @default(0) @map("split_cursor")
  splitCompleted Boolean            @default(false) @map("split_completed")
  chunksTotal    Int                @default(0) @map("chunks_total")
  rowsProcessed  BigInt             @default(0) @map("rows_processed")
  rowsRejected   BigInt             @default(0) @map("rows_rejected")
  error          String?
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt    DateTime?          @map("completed_at") @db.Timestamptz(6)

  chunks IngestionChunk[]

  @@index([status])
  @@map("ingestion_jobs")
}

model IngestionChunk {
  id            String               @id @default(uuid()) @db.Uuid
  jobId         String               @map("job_id") @db.Uuid
  seq           Int
  byteStart     BigInt               @map("byte_start")
  byteEnd       BigInt               @map("byte_end")
  status        IngestionChunkStatus @default(PENDING)
  attempts      Int                  @default(0)
  rowsProcessed Int                  @default(0) @map("rows_processed")
  rowsRejected  Int                  @default(0) @map("rows_rejected")
  error         String?
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  job IngestionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Idempotency key: redelivery of a COMPLETED (job, seq) is a no-op.
  @@unique([jobId, seq])
  @@index([jobId, status])
  @@map("ingestion_chunks")
}
